<odoo>

    <!-- LIST VIEW -->
    <record id="view_car_list" model="ir.ui.view">
        <field name="name">cars.car.list</field>
        <field name="model">cars.car</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" class="oe_avatar" options="{'size': [40, 40]}" />
                <field name="name"/>
                <field name="brand"/>
                <field name="model_year"/>
                <field name="price"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_car_form" model="ir.ui.view">
        <field name="name">cars.car.form</field>
        <field name="model">cars.car</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Bouton SELL -->
                    <button name="action_sell"
                            string="Sell"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'available'"/>
                    <!-- Statusbar -->
                    <field name="state" widget="statusbar" 
                        statusbar_visible="available,sold"
                        class="o_statusbar_status"/>
                </header>
                <sheet>

                    <!-- SMART BUTTON LEADS -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leads"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>

                    <group col="3">
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="brand_country"/>
                            <field name="model_year"/>
                            <field name="color"/>
                            <field name="price"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>

                        <group>
                            <field name="body_type" widget="radio"/>
                            <field name="fuel_type" widget="radio"/>
                        </group>

                        <!-- RIGHT SIDE (MAIN IMAGE) -->
                        <group>
                            <field name="image" widget="image" class="oe_avatar"/>  
                        </group>

                    </group>

                    <group>
                        <field name="feature_ids" widget="many2many_tags"/>
                    </group>

                    <notebook>

                        <page string="History">
                            <group>
                                <field name="distance"/>
                                <field name="owners_count"/>
                                <field name="cylinders"/>
                                <field name="is_damaged" widget="boolean_toggle"/>
                            </group>
                        </page>

                        <page string="Images">
                            <field name="image_ids">
                                <kanban class="o_kanban_small_column">
                                    <templates>
                                        <t t-name="card">
                                            <div class="o_kanban_record">
                                                <div class="o_kanban_image">
                                                    <field name="image" widget="image"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>

                    </notebook>

                </sheet>
                <chatter/>
            </form>        
        </field>
    </record>

    <!-- vue popup -->
    <record id="view_car_sell_wizard" model="ir.ui.view">
        <field name="name">car.sell.wizard.form</field>
        <field name="model">car.sell.wizard</field>
        <field name="arch" type="xml">
            <form string="Sell Car">
                <group>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="message"/>
                </group>

                <footer>
                    <button name="confirm_sell"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- vue calendrier -->
    <record id="view_car_calendar" model="ir.ui.view">
        <field name="name">cars.car.calendar</field>
        <field name="model">cars.car</field>
        <field name="arch" type="xml">
            <calendar string="Car Calendar"
                    date_start="date_start"
                    date_stop="date_end"
                    mode="month"
                    color="name">
                <field name="name"/>
            </calendar>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="view_car_pivot" model="ir.ui.view">
        <field name="name">cars.car.pivot</field>
        <field name="model">cars.car</field>
        <field name="arch" type="xml">
            <pivot string="Car Analysis">

                <!-- MESURES -->
                <field name="price" type="measure"/>
                <field name="distance" type="measure"/>
                <field name="owners_count" type="measure"/>

                <!-- LIGNES -->
                <field name="brand" type="row"/>
                <field name="state" type="row"/>

                <!-- COLONNES -->
                <field name="date_start" interval="month" type="col"/>

            </pivot>
        </field>
    </record>
    
</odoo>