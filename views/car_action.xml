<odoo>

    <record id="action_car" model="ir.actions.act_window">
        <field name="name">Cars</field>
        <field name="res_model">cars.car</field>
        <field name="view_mode">list,form,calendar,pivot</field>
        <field name="context">{}</field>
    </record>

    <!-- Action URL directe -->
    <record id="action_export_pdf_url" model="ir.actions.act_url">
        <field name="name">Export Cars PDF</field>
        <field name="url">/cars/export/pdf</field>
        <field name="target">new</field>
    </record>

    <record id="action_car_set_available" model="ir.actions.server">
        <field name="name">Mark as Available</field>
        <field name="model_id" ref="model_cars_car"/>
        <field name="binding_model_id" ref="model_cars_car"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            records.write({'state': 'available'})
        </field>
    </record>
    
    <record id="action_car_set_sold" model="ir.actions.server">
        <field name="name">Mark as Sold</field>
        <field name="model_id" ref="model_cars_car"/>
        <field name="binding_model_id" ref="model_cars_car"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            records.write({'state': 'sold'})
        </field>
    </record>

</odoo>